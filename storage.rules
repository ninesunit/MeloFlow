rules_version = '2';

// Only the administrator can upload or list files. Housemates open receipts
// and the DuitNow QR through the tokenised download links in WhatsApp
// messages, which work without signing in.
// Set the email below with `npm run set-admin -- you@example.com`.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'you@example.com';
    }

    match /receipts/{file} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }
    match /payment/{file} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
