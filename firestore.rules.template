rules_version = '2';

// TEMPLATE — edit this file, not firestore.rules. `npm run deploy:rules` (or
// `npm run set-admin`) fills in the admin list below from ADMIN_EMAILS in
// .env.local and writes firestore.rules, which is git-ignored so the admin
// emails never end up in the public repo.
//
// Only the admin accounts may read or write anything, except opening a shared
// file by its exact id (see /files). All admins see and edit the same data.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [__ADMIN_EMAILS__];
    }

    match /transactions/{id} {
      allow read, write: if isAdmin();
    }
    match /receivables/{id} {
      allow read, write: if isAdmin();
    }
    match /balances/{name} {
      allow read: if isAdmin();
      allow write: if isAdmin() && request.resource.data.runningBalance is number;
    }
    match /balanceEvents/{id} {
      allow read, create: if isAdmin();
      // The audit trail is append-only.
      allow update, delete: if false;
    }
    match /userSettings/{id} {
      allow read, write: if isAdmin();
    }
    match /appliances/{id} {
      allow read, write: if isAdmin();
    }

    // Receipts and the DuitNow QR, stored as base64 (Cloud Storage needs the
    // Blaze plan). Ids are long random strings, so a link to one file works
    // like a private share link: anyone with the exact id can open that file,
    // but only the admin can list or change them.
    match /files/{id} {
      allow get: if id.size() >= 30;
      allow list: if isAdmin();
      allow create: if isAdmin()
        && id.size() >= 30
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000
        && request.resource.data.mimeType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf'];
      allow delete: if isAdmin();
      allow update: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
