# Copy to .env.local for local development. On Vercel, add the same names under
# Project → Settings → Environment Variables.

# ── Firebase web app (Firebase console → Project settings → Your apps → Web app).
#    These identify your project and are safe in the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Server only (no NEXT_PUBLIC_ prefix, so never sent to the browser).
# Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model used for bill reading, messages, spike notes, forecasts and categorising.
GEMINI_MODEL=gemini-3.8-flash
# The one account allowed to use the AI route (must match firestore.rules).
ADMIN_EMAIL=you@example.com
